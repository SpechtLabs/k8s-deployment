      "type": "stat",
      "title": "Power source",
      "description": "802.3at PoE+, or 802.3af PoE / USB-C (then the power policy caps the CPU at 1200 MHz). Agents up to 0.11.4 label the source 1/0 instead of poe+/poeOrUsbC; both match.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_replace(max by (instance) (computeblade_power_status{type=~\"1|poe\\\\+\"}), \"blade\", \"$1\", \"instance\", \"([^:]+):.*\")",
          "legendFormat": "{{blade}}",
          "refId": "A",
          "range": false,
          "instant": true
