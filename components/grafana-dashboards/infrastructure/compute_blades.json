    {
      "type": "stat",
      "title": "Health",
      "description": "Worst health condition the agent reports: critical mode (SoC at the critical temperature), a stalled fan, under-voltage or CPU throttling (Raspberry Pi firmware flags).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_replace(max by (instance) ((computeblade_state_state{state=\"critical\"} * 4) or (computeblade_state_state{state=\"fan_stall\"} * 3) or (computeblade_state_state{state=\"undervoltage\"} * 2) or (computeblade_state_state{state=\"throttled\"} * 1)), \"blade\", \"$1\", \"instance\", \"([^:]+):.*\")",
          "legendFormat": "{{blade}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Throttled",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "Under-voltage",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "Fan stalled",
                  "color": "red",
                  "index": 3
                },
                "4": {
                  "text": "Critical",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      },
